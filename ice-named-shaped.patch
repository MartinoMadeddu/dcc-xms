-/// A port: a small dot in its type's colour on the node's edge, larger
-/// under the pointer.
-fn draw_port(painter: &egui::Painter, at: egui::Pos2, colour: egui::Color32, hot: bool) {
+/// A port, shaped by kind and coloured by data type: round for values,
+/// square for geometry, a chevron pointing along the flow for anything else
+/// (execute and the like). Larger under the pointer. The shape says what can
+/// connect even without telling the colours apart.
+fn draw_port(painter: &egui::Painter, at: egui::Pos2, hint: &str, hot: bool) {
     let r = if hot { PORT_R + 1.5 } else { PORT_R };
-    painter.circle_filled(at, r + 1.0, pal::PORT_RIM());
-    painter.circle_filled(at, r, colour);
+    let colour = type_colour(hint);
+    let rim = egui::Stroke::new(1.0_f32, pal::PORT_RIM());
+    match hint {
+        "Float" | "Int" | "Vec3" => {
+            painter.circle_filled(at, r + 1.0, pal::PORT_RIM());
+            painter.circle_filled(at, r, colour);
+        }
+        "Mesh" => {
+            let sq = egui::Rect::from_center_size(at, egui::vec2(r * 2.0, r * 2.0));
+            painter.rect_filled(sq, 0.0, colour);
+            painter.rect_stroke(sq, 0.0, rim);
+        }
+        _ => {
+            let pts = vec![
+                egui::pos2(at.x - r, at.y - r * 1.1),
+                egui::pos2(at.x + r * 1.1, at.y),
+                egui::pos2(at.x - r, at.y + r * 1.1),
+            ];
+            painter.add(egui::Shape::convex_polygon(pts, colour, rim));
+        }
+    }
 }
 
