+/// Where everything of a node sits, relative to its top-left corner.
+struct Layout {
+    size:    egui::Vec2,
+    inputs:  Vec<egui::Vec2>,
+    outputs: Vec<egui::Vec2>,
+    /// Row showing a constant's value, if any.
+    value:   Option<f32>,
+}
+
+fn layout(node: &SubnetNode) -> Layout {
+    let value = constant_text(&node.node_type);
+    // Inputs from the first row down; the first output on the title row,
+    // the others on the rows below it, on the right.
+    let rows = node.inputs.len().max(node.outputs.len().saturating_sub(1)) + value.is_some() as usize;
+    let title = format!("{} {}", subnet_node_icon(&node.node_type), node.name);
+    let widest_row = (0..rows).map(|r| {
+        let l = node.inputs.get(r).map(|i| i.name.chars().count()).unwrap_or(0);
+        let o = node.outputs.get(r + 1).map(|o| o.name.chars().count()).unwrap_or(0);
+        l + o + 3
+    }).max().unwrap_or(0);
+    let header = title.chars().count() + node.outputs.first().map(|o| o.name.chars().count() + 3).unwrap_or(0);
+    let value_len = value.as_ref().map(|v| v.chars().count()).unwrap_or(0);
+    let w = (widest_row.max(header).max(value_len) as f32 * CHAR_W + 28.0).max(MIN_W).round();
+    let h = HEADER_H + rows as f32 * ROW_H + PAD_B;
+    let row_y = |r: usize| HEADER_H + (r as f32 + 0.5) * ROW_H;
+    Layout {
+        size:    egui::vec2(w, h),
+        inputs:  (0..node.inputs.len()).map(|r| egui::vec2(0.0, row_y(r))).collect(),
+        outputs: (0..node.outputs.len()).map(|r| egui::vec2(w, if r == 0 { HEADER_H * 0.5 } else { row_y(r - 1) })).collect(),
+        value:   value.map(|_| row_y(rows - 1)),
+    }
 }
 
