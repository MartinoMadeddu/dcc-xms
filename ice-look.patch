-    egui::pos2(node.position.x + NODE_W, node.position.y + NODE_H * t)
+    node.position + layout(node).outputs.get(idx).copied().unwrap_or_default()
+}
+
+/// The value a constant node shows under its title.
+fn constant_text(t: &SubnetNodeType) -> Option<String> {
+    match t {
+        SubnetNodeType::ConstVec3  { value } => Some(format!("{:.3}  {:.3}  {:.3}", value.x, value.y, value.z)),
+        SubnetNodeType::ConstFloat { value } => Some(format!("{value:.3}")),
+        SubnetNodeType::ConstInt   { value } => Some(format!("{value}")),
+        _ => None,
+    }
+}
+
+/// What kind of node it is, for its tint.
+fn tint(t: &SubnetNodeType) -> (egui::Color32, egui::Color32) {
+    match t {
+        SubnetNodeType::SubInput | SubnetNodeType::SubOutput => pal::TERMINAL(),
+        SubnetNodeType::ConstVec3 { .. } | SubnetNodeType::ConstFloat { .. } | SubnetNodeType::ConstInt { .. } => pal::DATA(),
+        SubnetNodeType::ScatterPoints { .. } | SubnetNodeType::GetTemplate | SubnetNodeType::CopyToPoints => pal::GEOMETRY(),
+        _ => pal::MATH(),
+    }
 }
 
