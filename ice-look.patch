+/// A port: a ring in its type's colour, filled when wired, larger and
+/// lighter under the pointer.
+fn draw_port(painter: &egui::Painter, at: egui::Pos2, colour: egui::Color32, filled: bool, hot: bool) {
+    let r = if hot { PORT_R + 1.5 } else { PORT_R };
+    let colour = if hot { colour.gamma_multiply(1.25) } else { colour };
+    painter.circle_filled(at, r + 1.0, pal::PORT_RIM());
+    if filled {
+        painter.circle_filled(at, r, colour);
+    } else {
+        painter.circle_filled(at, r, egui::Color32::from_rgb(60, 60, 60));
+        painter.circle_stroke(at, r - 1.0, egui::Stroke::new(2.0_f32, colour));
     }
 }
 
