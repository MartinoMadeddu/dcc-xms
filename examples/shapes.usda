#usda 1.0
(
    defaultPrim = "Shapes"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Shapes"
{
    def Mesh "Pyramid"
    {
        point3f[] points = [(-0.5, 0, -0.5), (0.5, 0, -0.5), (0.5, 0, 0.5), (-0.5, 0, 0.5), (0, 0.9, 0)]
        int[] faceVertexCounts = [4, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 3, 0, 4, 1, 1, 4, 2, 2, 4, 3, 3, 4, 0]
        double3 xformOp:translate = (-1.4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Prism"
    {
        point3f[] points = [(-0.4, 0, -0.5), (0.4, 0, -0.5), (0, 0.7, -0.5), (-0.4, 0, 0.5), (0.4, 0, 0.5), (0, 0.7, 0.5)]
        int[] faceVertexCounts = [3, 3, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 1, 3, 4, 5, 0, 1, 4, 3, 1, 2, 5, 4, 2, 0, 3, 5]
    }

    def Mesh "Octahedron"
    {
        point3f[] points = [(0.5, 0.5, 0), (-0.5, 0.5, 0), (0, 1, 0), (0, 0, 0), (0, 0.5, 0.5), (0, 0.5, -0.5)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 4, 2, 1, 4, 1, 3, 4, 3, 0, 4, 2, 0, 5, 1, 2, 5, 3, 1, 5, 0, 3, 5]
        double3 xformOp:translate = (1.4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
